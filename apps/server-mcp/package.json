{
  "name": "server-mcp",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun --minify && bun run build:assets",
    "build:assets": "mkdir -p dist/widget/get-time && cp src/widget/get-time/get-time.html dist/widget/get-time/get-time.html",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "bun --watch run src/index.ts",
    "inspector": "bun run dev & sleep 2 && npx @mcpjam/inspector@latest; kill %1",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.43",
    "@repo/domain": "workspace:*",
    "@repo/observability": "workspace:*",
    "effect": "4.0.0-beta.43"
  },
  "devDependencies": {
    "@effect/language-service": "^0.84.2",
    "@effect/vitest": "4.0.0-beta.43",
    "@repo/config-typescript": "workspace:*",
    "@types/bun": "1.3.11",
    "vitest": "^4.1.2"
  }
}
