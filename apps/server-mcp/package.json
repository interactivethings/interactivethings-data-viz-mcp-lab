{
  "name": "server-mcp",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun --minify && bun scripts/copy-public.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "bun --watch run src/index.ts",
    "inspector": "npx @mcpjam/inspector@latest",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.43",
    "@repo/domain": "workspace:*",
    "@repo/observability": "workspace:*",
    "effect": "4.0.0-beta.43"
  },
  "devDependencies": {
    "@effect/language-service": "^0.84.2",
    "@effect/vitest": "4.0.0-beta.43",
    "@repo/widget-bar-chart": "workspace:*",
    "@repo/widget-line-chart": "workspace:*",
    "@repo/widget-scatterplot": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/bun": "1.3.11",
    "vitest": "^4.1.2"
  }
}
