{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "server-mcp#build": {
      "dependsOn": [
        "@repo/widget-bar-chart#build",
        "@repo/widget-line-chart#build",
        "@repo/widget-scatterplot#build"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "clean": {
      "cache": false
    },
    "//#format": {},
    "//#lint": {
      "cache": false
    }
  }
}
